{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Microdex: one turn",
      "type": "debugpy",
      "request": "launch",
      "module": "microdex",
      "args": [
        "${input:microdexPrompt}",
        "--cwd",
        "${workspaceFolder}"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Microdex: interactive",
      "type": "debugpy",
      "request": "launch",
      "module": "microdex",
      "args": [
        "--cwd",
        "${workspaceFolder}"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Microdex: debug-loop",
      "type": "debugpy",
      "request": "launch",
      "module": "microdex",
      "args": [
        "debug-loop"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-s",
        "--tb=short"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Pytest: Test Explorer",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": [
        "debug-test"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": {
        "hidden": true
      }
    }
  ],
  "inputs": [
    {
      "id": "microdexPrompt",
      "type": "promptString",
      "description": "Prompt for one Microdex turn",
      "default": "Read README.md and summarize the three runtime layers."
    }
  ]
}
